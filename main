  <!-- SCRIPTS -->
  <script>
    var PAGE_KEYS = ['home', 'about', 'mfg', 'quality', 'contact'];

    var NAV_DEFAULT_DESKTOP = 'relative text-[15px] font-medium text-ink-muted transition-colors duration-200 hover:text-ink';
    var NAV_ACTIVE_DESKTOP = 'relative text-[15px] font-semibold text-ink after:absolute after:-bottom-1.5 after:left-0 after:h-0.5 after:w-full after:rounded-full after:bg-brand';

    var NAV_DEFAULT_DRAWER = 'block w-full rounded-xl2 px-3 py-4 text-[1.75rem] font-bold tracking-tight text-ink transition-colors hover:bg-neutral-100 active:bg-neutral-100 text-left';
    var NAV_ACTIVE_DRAWER = 'block w-full rounded-xl2 px-3 py-4 text-[1.75rem] font-bold tracking-tight text-brand transition-colors before:mr-3 before:inline-block before:h-2.5 before:w-2.5 before:rounded-full before:bg-brand before:align-middle text-left';

    // Element that had focus before the drawer opened, restored on close.
    var lastFocusedBeforeDrawer = null;

    function showPage(name, pushHistory) {
      if (pushHistory === undefined) { pushHistory = true; }
      if (PAGE_KEYS.indexOf(name) === -1) { name = 'home'; }

      var pages = document.querySelectorAll('.page');
      for (var i = 0; i < pages.length; i++) {
        pages[i].classList.add('hidden');
      }
      var target = document.getElementById('page-' + name);
      if (target) { target.classList.remove('hidden'); }

      // Desktop nav active styling (Contact pill is a CTA — leave its styling intact)
      for (var k = 0; k < PAGE_KEYS.length; k++) {
        var key = PAGE_KEYS[k];
        var deskBtn = document.getElementById('nav-' + key);
        if (deskBtn && key !== 'contact') {
          deskBtn.className = (key === name) ? NAV_ACTIVE_DESKTOP : NAV_DEFAULT_DESKTOP;
        }
        var drawBtn = document.getElementById('dnav-' + key);
        if (drawBtn && key !== 'contact') {
          drawBtn.className = (key === name) ? NAV_ACTIVE_DRAWER : NAV_DEFAULT_DRAWER;
        }
      }

      // Only push a new history entry for user-initiated navigation. When invoked
      // from loadPageFromHash (popstate / initial load) we must NOT push, otherwise
      // every Back press would add a fresh forward entry and feel "stuck".
      if (pushHistory) {
        history.pushState(null, '', '#' + name);
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function loadPageFromHash() {
      var hash = (location.hash || '').replace('#', '');
      if (PAGE_KEYS.indexOf(hash) === -1) { hash = 'home'; }
      showPage(hash, false);
    }

    function toggleDrawer() {
      var drawer = document.getElementById('nav-drawer');
      if (!drawer) { return; }
      var isOpen = drawer.classList.contains('opacity-100');
      if (isOpen) { closeDrawer(); } else { openDrawer(); }
    }

    function openDrawer() {
      var drawer = document.getElementById('nav-drawer');
      if (!drawer) { return; }
      lastFocusedBeforeDrawer = document.activeElement;
      drawer.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
      drawer.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      drawer.removeAttribute('aria-hidden');
      drawer.removeAttribute('inert');
      document.body.classList.add('nav-open');
      var burger = document.getElementById('hamburger');
      if (burger) { burger.setAttribute('aria-expanded', 'true'); }
      // Move focus into the drawer so keyboard / screen-reader users land inside it.
      var firstFocusable = drawer.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
      if (firstFocusable) { firstFocusable.focus(); }
    }

    function closeDrawer() {
      var drawer = document.getElementById('nav-drawer');
      if (!drawer) { return; }
      drawer.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
      drawer.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      drawer.setAttribute('aria-hidden', 'true');
      drawer.setAttribute('inert', '');
      document.body.classList.remove('nav-open');
      var burger = document.getElementById('hamburger');
      if (burger) { burger.setAttribute('aria-expanded', 'false'); }
      // Restore focus to the hamburger (or whatever opened the drawer).
      if (lastFocusedBeforeDrawer && typeof lastFocusedBeforeDrawer.focus === 'function') {
        lastFocusedBeforeDrawer.focus();
      } else if (burger) {
        burger.focus();
      }
      lastFocusedBeforeDrawer = null;
    }

    function toggleFaq(el) {
      var item = el.closest('.faq-item');
      if (item) { item.classList.toggle('open'); }
    }

    // Escape closes the drawer when it is open; basic focus trap keeps Tab inside it.
    document.addEventListener('keydown', function (e) {
      var drawer = document.getElementById('nav-drawer');
      if (!drawer || !drawer.classList.contains('opacity-100')) { return; }

      if (e.key === 'Escape' || e.key === 'Esc') {
        e.preventDefault();
        closeDrawer();
        return;
      }

      if (e.key === 'Tab') {
        var focusable = drawer.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
        if (!focusable.length) { return; }
        var first = focusable[0];
        var last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    document.addEventListener('DOMContentLoaded', loadPageFromHash);
    window.addEventListener('popstate', loadPageFromHash);
  </script>
</body>
</html>
